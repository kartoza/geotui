# Unlock screen
msgid "Create Master Password"
msgstr "Criar Senha Mestra"

msgid "Set a master password to encrypt your\nGeoServer connection credentials."
msgstr "Defina uma senha mestra para criptografar\nsuas credenciais de conexao GeoServer."

